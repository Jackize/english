generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id                String           @id @default(cuid())
  email             String           @unique
  passwordHash      String?
  name              String?
  role              Role             @default(USER)
  xp                Int              @default(0)
  streak            Int              @default(0)
  lastStudyDate     DateTime?
  dailyGoalLessons  Int              @default(2)
  dailyGoalMinutes  Int              @default(20)
  onboardedAt       DateTime?
  targetLevel       String?
  placementLevel    String?
  createdAt         DateTime         @default(now())
  progress          LessonProgress[]
  attempts          QuizAttempt[]
  reviews           ReviewItem[]
  vocabReviews      VocabReviewItem[]
}

model Level {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  tagline     String?
  description String?
  order       Int
  createdAt   DateTime @default(now())
  lessons      Lesson[]
  topics       Topic[]
  readingUnits ReadingUnit[]
}

model Topic {
  id          String   @id @default(cuid())
  levelId     String
  name        String
  slug        String
  description String?
  icon        String   @default("menu_book")
  order       Int      @default(0)
  level       Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)
  lessons     Lesson[]

  @@unique([levelId, slug])
}

model Lesson {
  id               String           @id @default(cuid())
  levelId          String
  topicId          String?
  track            String
  title            String
  summary          String?
  order            Int              @default(0)
  xp               Int              @default(10)
  estimatedMinutes Int              @default(10)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  level            Level            @relation(fields: [levelId], references: [id], onDelete: Cascade)
  topic            Topic?           @relation(fields: [topicId], references: [id], onDelete: SetNull)
  sections         LessonSection[]
  vocab            VocabEntry[]
  questions        Question[]
  progress         LessonProgress[]
  attempts         QuizAttempt[]

  @@unique([track, levelId, order])
  @@index([track, levelId])
  @@index([topicId])
}

model LessonSection {
  id       String  @id @default(cuid())
  lessonId String
  title    String
  body     String
  remember String?
  order    Int     @default(0)
  lesson   Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

model VocabEntry {
  id        String  @id @default(cuid())
  lessonId  String
  word      String
  ipa       String?
  wordForm  String?
  meaningVi String
  meaningEn String?
  example   String?
  order     Int     @default(0)
  lesson    Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  reviews   VocabReviewItem[]

  @@index([lessonId])
}

model Question {
  id          String           @id @default(cuid())
  lessonId    String
  prompt      String
  explanation String?
  order       Int              @default(0)
  lesson      Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  choices     QuestionChoice[]
  reviews     ReviewItem[]

  @@index([lessonId])
}

model QuestionChoice {
  id         String   @id @default(cuid())
  questionId String
  label      String
  isCorrect  Boolean  @default(false)
  order      Int      @default(0)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  bestScore   Int       @default(0)
  quizTotal   Int       @default(0)
  attempts    Int       @default(0)
  completed   Boolean   @default(false)
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, completed])
}

model QuizAttempt {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  score     Int
  total     Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model ReviewItem {
  id              String    @id @default(cuid())
  userId          String
  questionId      String
  wrongCount      Int       @default(1)
  lastWrongAt     DateTime  @default(now())
  lastReviewedAt  DateTime?
  intervalDays    Int       @default(0)
  correctStreak   Int       @default(0)
  dueAt           DateTime  @default(now())
  resolved        Boolean   @default(false)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  question        Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId, resolved])
  @@index([userId, resolved, dueAt])
}

// ---------------------------------------------------------------------------
// Vocabulary review (Leitner 5 boxes)
// Mỗi từ mới vào mức 1. Đúng thì lên mức tiếp theo, sai thì quay về mức 1.
// Lịch ôn: mức 1 mỗi ngày, mức 2 mỗi 2 ngày, mức 3 mỗi 4 ngày,
// mức 4 mỗi 7 ngày, mức 5 mỗi 14 ngày.
// ---------------------------------------------------------------------------

model VocabReviewItem {
  id             String     @id @default(cuid())
  userId         String
  vocabId        String
  level          Int        @default(1)
  correctStreak  Int        @default(0)
  wrongCount     Int        @default(0)
  lastReviewedAt DateTime?
  dueAt          DateTime   @default(now())
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocab          VocabEntry @relation(fields: [vocabId], references: [id], onDelete: Cascade)

  @@unique([userId, vocabId])
  @@index([userId, dueAt])
  @@index([userId, level])
}

// ---------------------------------------------------------------------------
// Reading track
// Reading có nhiều dạng câu hỏi và nội dung riêng (passage, evidence,
// matching, short answer) nên dùng bảng chuyên biệt thay vì nhồi vào Question.
// ---------------------------------------------------------------------------

model ReadingUnit {
  id               String                   @id @default(cuid())
  levelId          String
  slug             String
  unitNumber       Int
  unitTotal        Int                      @default(10)
  title            String
  passageTitle     String
  goal             String
  description      String
  lengthWords      Int
  estimatedMinutes Int
  timeLabel        String
  questionTypes    String[]                 @default([])
  warmUp           String[]                 @default([])
  passage          String[]                 @default([])
  source           String                   @default("")
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  level            Level                    @relation(fields: [levelId], references: [id], onDelete: Cascade)
  groups           ReadingQuestionGroup[]
  vocabulary       ReadingVocabularyEntry[]
  skill            ReadingSkill?
  mistakes         ReadingMistake[]

  @@unique([levelId, slug])
  @@unique([levelId, unitNumber])
  @@index([levelId, unitNumber])
}

model ReadingSkill {
  id      String      @id @default(cuid())
  unitId  String      @unique
  title   String
  intro   String
  bullets String[]    @default([])
  unit    ReadingUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
}

model ReadingQuestionGroup {
  id            String            @id @default(cuid())
  unitId        String
  badge         String
  label         String
  instructionVi String
  order         Int               @default(0)
  unit          ReadingUnit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  questions     ReadingQuestion[]

  @@index([unitId, order])
}

model ReadingQuestion {
  id              String               @id @default(cuid())
  groupId         String
  number          Int
  kind            String
  prompt          String
  explanation     String
  evidence        String?
  answerKey       String?
  acceptedAnswers String[]             @default([])
  modelAnswer     String?
  order           Int                  @default(0)
  group           ReadingQuestionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  choices         ReadingChoice[]
  matchItems      ReadingMatchItem[]

  @@unique([groupId, number])
  @@index([groupId, order])
}

model ReadingChoice {
  id         String          @id @default(cuid())
  questionId String
  choiceKey  String
  label      String
  text       String?
  isCorrect  Boolean         @default(false)
  order      Int             @default(0)
  question   ReadingQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, choiceKey])
  @@index([questionId, order])
}

model ReadingMatchItem {
  id         String          @id @default(cuid())
  questionId String
  side       String
  itemKey    String
  label      String
  matchKey   String?
  order      Int             @default(0)
  question   ReadingQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, side, itemKey])
  @@index([questionId, side, order])
}

model ReadingVocabularyEntry {
  id        String      @id @default(cuid())
  unitId    String
  word      String
  ipa       String      @default("")
  meaningVi String
  example   String      @default("")
  order     Int         @default(0)
  unit      ReadingUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([unitId, word])
  @@index([unitId, order])
}

model ReadingMistake {
  id     String      @id @default(cuid())
  unitId String
  title  String
  body   String
  order  Int         @default(0)
  unit   ReadingUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([unitId, order])
}
